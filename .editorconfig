# EditorConfig de PKuatia (https://editorconfig.org). Fase D, 0.3.1.
# Sin end_of_line a propósito: los finales de línea los normaliza git (text=auto); el editor conserva los del archivo.
root = true

[*]
charset = utf-8
indent_style = space
indent_size = 4
trim_trailing_whitespace = true
insert_final_newline = true

[*.md]
trim_trailing_whitespace = false

[*.{yml,yaml}]
indent_size = 2

[*.neon]
indent_style = tab

[*.{xsd,xml}]
indent_size = 2
trim_trailing_whitespace = false
