# Nivel 3 desde 0.3.1 (Fase D, D9 y D10). phpstan-deprecation-rules marca el uso de código @deprecated.
# Cada entrada de phpstan-baseline.neon está justificada en docs/evaluacion-2026-10-02/PLAN-FASE-D.md (bitácora D9/D10):
# "sin runtime" (isset/?? sobre propiedad no anulable), "API" (corregirla exige cambiar una firma pública) o
# "deprecado a propósito" (código propio que se conserva obsoleto por compatibilidad).
parameters:
    level: 3
    # Analiza como PHP 8.1 (el mínimo que declara composer.json) con independencia del PHP que ejecuta PHPStan, para
    # que el resultado sea el mismo en toda la matriz del CI (8.1–8.5). Sin esto, bajo PHP 8.4+ PHPStan agrega
    # avisos propios de esa versión (p. ej. unset de propiedades que "podrían tener hooks" en una subclase) que no
    # describen un problema del código y harían fallar solo esos jobs (Fase D, Q-D4).
    phpVersion: 80100
    paths:
        - src

includes:
    - phpstan-baseline.neon
    - vendor/phpstan/phpstan-deprecation-rules/rules.neon

